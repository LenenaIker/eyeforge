# The demo server's /opt/eyeforge/.env: names only, the values never go in the repo.
# Copy it to the server, fill it in there (or with scp from a local file), chmod 600.

# Login (sim2chip/auth.py)
SIM2CHIP_PUBLIC_URL=https://eyeforge.app
SIM2CHIP_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Judges and accounts (sim2chip/accounts.py)
SIM2CHIP_CONTACT=
# End of the judging, ISO date or time in UTC (after it, judge accounts pay like everyone)
SIM2CHIP_JUDGE_UNTIL=
# Cloud spend cap per day for the whole server, in dollars
SIM2CHIP_DAILY_USD=30

# Nebius: Token Factory for the interview, Object Storage for the jobs, MysteryBox secrets for the GPU jobs
NEBIUS_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIM2CHIP_NEBIUS_PROJECT=
SIM2CHIP_NEBIUS_SECRET=
SIM2CHIP_S3_SECRET=

# Web search in the interview (optional)
TAVILY_API_KEY=
