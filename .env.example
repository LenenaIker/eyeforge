# Copy to .env (gitignored) and fill in. Every value can also come from the environment.

# Nebius Token Factory (interview, photo labeling, asset QA)
NEBIUS_API_KEY=

# Where jobs/ and cache/ live (default: ./data). Use a disk with space.
SIM2CHIP_HOME=

# Local runtimes (only for the local backend)
# Isaac Sim 5.1 python.sh, e.g. /opt/isaacsim/isaac-sim-5.1.0/python.sh (empty: no local rendering)
SIM2CHIP_ISAAC_PYTHON=
# Teacher (SAM 3): a Python with torch and transformers >= 5; HF_TOKEN if not logged in with `hf auth login`
SIM2CHIP_SAM3_PYTHON=
HF_TOKEN=

# 3D from photos (TRELLIS): its Python, its checkout and where model weights go
SIM2CHIP_TRELLIS_PYTHON=
SIM2CHIP_TRELLIS_DIR=
HF_HUB_CACHE=
TORCH_HOME=

# Nebius AI Cloud backend (--backend nebius)
SIM2CHIP_NEBIUS_PROJECT=
# Object storage keys for this machine, and the MysteryBox secret that gives them to the jobs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIM2CHIP_S3_SECRET=sim2chip-s3
# MysteryBox secret holding NEBIUS_API_KEY for jobs that call Token Factory
SIM2CHIP_NEBIUS_SECRET=
# Web server reachable by others (sim2chip serve --public): the access key in the link you hand out
SIM2CHIP_WEB_KEY=
# Public server: cloud GPU dollars allowed in any 24 h (default 30 with --public)
SIM2CHIP_DAILY_USD=
# Spend cap per run, in USD
SIM2CHIP_MAX_USD=5
# Optional: another region or GPU (the price and the name must match the platform)
# SIM2CHIP_REGION=eu-north1
# SIM2CHIP_NEBIUS_PLATFORM=gpu-l40s-a
# SIM2CHIP_NEBIUS_PRESET=1gpu-8vcpu-32gb
# SIM2CHIP_USD_PER_HOUR=1.55
# SIM2CHIP_GPU_NAME=L40S

# Web research in the interview (Tavily, app.tavily.com): real sizes and names instead of guesses
TAVILY_API_KEY=

# Login with Google or GitHub on a public server (sim2chip/auth.py), instead of SIM2CHIP_WEB_KEY.
# Judges use it free until SIM2CHIP_JUDGE_UNTIL (ISO date or time, UTC); SIM2CHIP_CONTACT is where judges and
# paused accounts write. Comments go on their own line: a value keeps anything written after it.
# SIM2CHIP_PUBLIC_URL=https://eyeforge.app
# SIM2CHIP_SESSION_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SIM2CHIP_JUDGE_UNTIL=
# SIM2CHIP_CONTACT=

# Top-ups of the balance with Stripe (sim2chip/payments.py, setup in docs/pagos.md). Test keys (sk_test_) charge
# nothing. SIM2CHIP_STRIPE_TAX=1 adds VAT on the checkout page (turns auto top-up off).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SIM2CHIP_STRIPE_TAX=

# Advanced, with their defaults. Leave them out unless you measured a reason.
# Python of the CPU and TensorFlow stages (default: the current one)
# SIM2CHIP_PYTHON=
# Count detector on phone/PC profiles: a PaddlePaddle Python and a PaddleDetection checkout (without both,
# the grid head counts)
# SIM2CHIP_PICODET_PYTHON=
# SIM2CHIP_PADDLEDET=
# SIM2CHIP_PICODET_STEPS=600
# Seeds trained at once on one GPU, and Token Factory calls in flight per stage
# SIM2CHIP_PARALLEL_SEEDS=3
# SIM2CHIP_LLM_WORKERS=8
# SIM2CHIP_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# A model per role instead of the preferred one (sim2chip/llm.py): SIM2CHIP_<ROLE>_MODEL with ROLE one of
# TEXT, VISION, DESCRIBE, SCENE, COMPARE, REASON
# SIM2CHIP_TEXT_MODEL=
# Shared warm GPU (needs the registry images; 0 turns it off), its idle and keep-alive seconds and timeout
# SIM2CHIP_WARM=1
# SIM2CHIP_WARM_IDLE_S=120
# SIM2CHIP_WARM_KEEP_S=300
# SIM2CHIP_WARM_HOURS=2
# Timeout in hours of a whole cloud run; "stage" mode runs one cloud job per stage instead of one per run
# SIM2CHIP_WORKER_HOURS=3
# SIM2CHIP_NEBIUS_MODE=worker
# The nebius command if not on the PATH, the bucket names' prefix, teacher weights already on disk
# SIM2CHIP_NEBIUS_CLI=
# SIM2CHIP_BUCKET_PREFIX=sim2chip
# SIM2CHIP_WEIGHTS_DIR=

# Set by the system for its own processes, never by hand: SIM2CHIP_RUNS_ON, SIM2CHIP_LABEL_SAMPLE, S2C_*.
